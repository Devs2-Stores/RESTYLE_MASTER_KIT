{
  "version": 1,
  "policy": {
    "merchantData": "settings-only"
  },
  "preview": {
    "status": "pending",
    "baseUrl": ""
  },
  "designDefaults": {
    "canvasColor": "#FFFFFF",
    "mobileRootFontPx": 14,
    "priceColor": "#C8102E",
    "sectionSpace": "clamp(2.5rem, 6vw, 4.5rem)",
    "gutterToken": "--<pfx>-gutter",
    "homeSectionOrder": [],
    "typeScale": {
      "minTextPx": 12
    },
    "spacingScale": [4, 8, 12, 16, 24, 32, 48, 64],
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "16px"
    },
    "controlHeight": {
      "mobile": 40,
      "desktop": 40
    },
    "iconStroke": 1.5,
    "cardDensity": "comfortable",
    "homeSectionBudget": {
      "min": 6,
      "max": 10
    }
  },
  "screens": [
    {
      "name": "home",
      "path": "/",
      "status": "implemented-static",
      "landmarks": [
        {
          "name": "hero",
          "source": "approved-design:hero",
          "target": "templates/index.liquid",
          "status": "pending"
        }
      ],
      "evidence": {
        "desktop": "",
        "mobile": ""
      }
    }
  ],
  "qaGate": {
    "widths": [320, 375, 768, 1024, 1440],
    "coverageFloor": 1
  },
  "features": [
    {
      "name": "smart-search",
      "status": "pending",
      "sourceHooks": ["search modal trigger", "view=smart endpoint"],
      "targetHooks": [
        {
          "file": "snippets/header.liquid",
          "contains": "data-action=\"open-search-modal\""
        },
        {
          "file": "templates/search.smart.liquid",
          "contains": "search.results"
        }
      ],
      "evidence": []
    }
  ],
  "requiredData": [
    {
      "type": "catalog",
      "minProducts": 12,
      "minImagesPerProduct": 3
    },
    {
      "type": "collection",
      "handle": "featured-products",
      "minItems": 6,
      "setting": "home_featured_collection"
    },
    {
      "type": "blog",
      "handle": "journal",
      "minItems": 3,
      "setting": "home_blog"
    },
    {
      "type": "menu",
      "handle": "main-menu",
      "minDepth": 2,
      "minItems": 8,
      "setting": "main_menu"
    }
  ],
  "settingsHandleWaivers": [],
  "sharedPrimitives": [
    {
      "name": "product-card",
      "occurrences": 2,
      "canonical": "snippets/product-card.liquid"
    }
  ],
  "cssOwnership": [
    {
      "component": "primary-button",
      "legacySelectors": [".button-primary"],
      "targetSelectors": [".brand-button"],
      "allowed": false
    }
  ],
  "allowlists": {
    "merchantDefaults": [
      {
        "file": "snippets/head-script.liquid",
        "setting": "products_per_page",
        "reason": "Numeric pagination limit fallback; alternatively write 'settings.products_per_page | plus: 0' with a blank check."
      }
    ],
    "themeImportant": [
      {
        "file": "assets/theme.css",
        "contains": ".hidden"
      }
    ],
    "vendorCss": ["swiper.css", "aos.css"]
  },
  "residueMarkers": [
    { "value": "Stitch source:", "finalOnly": false },
    { "value": "Generated by", "finalOnly": false },
    { "value": "TODO", "finalOnly": false },
    { "value": "FIXME", "finalOnly": false },
    { "value": "hrv-hot-reload", "finalOnly": true }
  ]
}
