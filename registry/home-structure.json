    "testimonial": ["testimonial", "review", "danh-gia", "feedback", "cam-nhan"],
    "blog": ["blog", "article", "tin-tuc", "bai-viet", "journal"],
    "newsletter": ["newsletter", "subscribe", "dang-ky", "nhan-tin"],
    "brands": ["brand", "partner", "thuong-hieu", "doi-tac", "logo"],
